# Copy to .env (never commit .env) and fill in. Every process in this repo
# reads it: ask, the gateway, the automation runner, the Slack receiver.

# --- Claude (required) --------------------------------------------------------
# An Anthropic API key from https://console.anthropic.com (billed per token).
# Use an API key whenever anyone besides you talks to your agents: Anthropic's
# terms don't allow running a bot for other people on a Free/Pro/Max/Ultra
# subscription. See README → "Claude credentials".
ANTHROPIC_API_KEY=
# Path to the Claude Code CLI if it isn't on PATH (default: claude)
# CLAUDE_BIN=/home/you/.local/bin/claude

# --- Report channels (config/channels.yaml) ------------------------------------
# Channel ids that agents and automations post finished results to with the
# post_report tool. Leave empty and posting says "not connected" instead.
SLACK_CHANNEL_GENERAL=
SLACK_CHANNEL_DIGEST=

# --- Failure alerts ---------------------------------------------------------------
# A failed or degrading automation posts here (a Slack channel id), as this agent.
ALERT_CHANNEL_ID=
ALERT_POST_AS=scout
# Your Slack member id, mentioned in alerts (Slack profile, then Copy member ID).
OPERATOR_SLACK_ID=

# --- Slack adapter (optional): one pair per agent --------------------------------
# Only needed if your agents answer in Slack or post reports there.
# Name = SLACK_<SLUG>_SIGNING_SECRET / SLACK_<SLUG>_BOT_TOKEN, where <SLUG> is
# the agent's key in agents/agents.json, uppercased, dashes become underscores.
# Signing secret: your Slack app, Basic Information, App Credentials.
# Bot token: your Slack app, OAuth & Permissions, Bot User OAuth Token (xoxb-...).
SLACK_SCOUT_SIGNING_SECRET=
SLACK_SCOUT_BOT_TOKEN=

# Receiver port (default 8790) and host (default 127.0.0.1; keep it on loopback
# and put a TLS proxy or tunnel in front).
# SLACK_RECEIVER_PORT=8790
# Kill switch: 1 = acknowledge every Slack event, process none.
# SLACK_AGENTS_DISABLED=0

# --- How agents refer to you ----------------------------------------------------
# Used in agent instructions ("escalate to <name>"). Default: "the operator".
OPERATOR_NAME=

# --- Optional -------------------------------------------------------------------
# Per-agent Slack avatars: <AVATAR_BASE_URL>/<slug>.png (needs chat:write.customize).
# AVATAR_BASE_URL=
# GitHub token for the github upstream in config/gateway.yaml (fine-grained,
# scoped to the repos your agents may touch).
# GITHUB_PERSONAL_ACCESS_TOKEN=
# OpenRouter key: enables the gateway's second_opinion tool (cross-model review).
# OPENROUTER_API_KEY=
# Path to the gh CLI if it isn't on PATH (only for agents with autoMerge repos).
# GH_BIN=
