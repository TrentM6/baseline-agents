# Copy to .env (never commit .env) and fill in. Every process in this repo
# reads it: the Slack receiver, the automation runner, the gateway, ask.mjs.

# --- Claude (required) --------------------------------------------------------
# Headless `claude -p` needs credentials that don't expire on you. Either:
#   a long-lived Claude subscription token: run `claude setup-token`, paste here
CLAUDE_CODE_OAUTH_TOKEN=
#   or an API key from console.anthropic.com (billed per token)
# ANTHROPIC_API_KEY=
# Path to the Claude Code CLI if it isn't on PATH (default: claude)
# CLAUDE_BIN=/home/you/.local/bin/claude

# --- Slack: one pair per agent ------------------------------------------------
# Name = SLACK_<SLUG>_SIGNING_SECRET / SLACK_<SLUG>_BOT_TOKEN, where <SLUG> is
# the agent's key in agents/agents.json, uppercased, dashes → underscores.
# Signing secret: your Slack app → Basic Information → App Credentials.
# Bot token: your Slack app → OAuth & Permissions → Bot User OAuth Token (xoxb-…).
SLACK_SCOUT_SIGNING_SECRET=
SLACK_SCOUT_BOT_TOKEN=

# Receiver port (default 8790) and host (default 127.0.0.1 — keep it on
# loopback and put a TLS proxy or tunnel in front).
# SLACK_RECEIVER_PORT=8790
# Kill switch: 1 = acknowledge every Slack event, process none.
# SLACK_AGENTS_DISABLED=0

# --- Automations ----------------------------------------------------------------
# Channel the example kb-digest automation posts to (channel id, e.g. C0123456789).
# Leave empty and it writes files/kb-digest.md without posting.
DIGEST_CHANNEL_ID=

# Failure alerts: a failed or degrading automation posts here, as this agent.
ALERT_CHANNEL_ID=
ALERT_POST_AS=scout
# Your Slack member id, mentioned in alerts (Slack profile → ⋮ → Copy member ID).
OPERATOR_SLACK_ID=

# --- How agents refer to you ----------------------------------------------------
# Used in agent instructions ("escalate to <name>"). Default: "the operator".
OPERATOR_NAME=

# --- Optional -------------------------------------------------------------------
# Per-agent Slack avatars: <AVATAR_BASE_URL>/<slug>.png (needs chat:write.customize).
# AVATAR_BASE_URL=
# GitHub token for the github upstream in config/gateway.yaml (fine-grained,
# scoped to the repos your agents may touch).
# GITHUB_PERSONAL_ACCESS_TOKEN=
# OpenRouter key: enables the gateway's second_opinion tool (cross-model review).
# OPENROUTER_API_KEY=
# Path to the gh CLI if it isn't on PATH (only for agents with autoMerge repos).
# GH_BIN=
