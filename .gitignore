# secrets, never committed
.env
.env.*
!.env.example
*.pem
*.key

# runtime state (run logs, sessions, receipts, locks)
logs/*
!logs/.gitkeep

# automation outputs are regenerated each run; commit the ones you want to keep
files/*
!files/.gitkeep

# repos your agents work in (cloned locally, each with its own git)
workspaces/

node_modules/
.DS_Store

# generated per machine by npm run agents:sync
.claude/agents/

# owner working notes, not part of the template
PROJECT.md

# generated by npm run gateway:on (absolute paths, per machine)
.mcp.json
config/gateway.off.yaml
